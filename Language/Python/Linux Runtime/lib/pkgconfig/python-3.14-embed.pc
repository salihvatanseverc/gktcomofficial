# See: man pkg-config
prefix=/home/salih/python-runtime
exec_prefix=${prefix}
libdir=${exec_prefix}/lib
includedir=${prefix}/include

Name: Python
Description: Embed Python into an application
Requires:
Version: 3.14
Libs.private: -ldl 
Libs: -L${libdir} -lpython3.14
Cflags: -I${includedir}/python3.14
